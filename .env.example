# ENVIRONMENT SETUP GUIDE
# =======================
# 
# File Priority (Vite loads in this order):
# 1. .env.local (highest priority, ignored by git - use for local dev)
# 2. .env (default, tracked in git - safe staging defaults)
# 3. Vercel overrides these with its own environment variables for production
#
# For Local Development:
# - Copy this file to `.env.local`
# - .env.local is ignored by git (safe for your local config)
# - Update values below in .env.local

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_APP_MEASUREMENT_ID=your_measurement_id

# Backend API URL
# Local dev should use: https://limes-staging.up.railway.app
# Production (set in Vercel): https://limes-production.up.railway.app
VITE_API_URL=https://limes-staging.up.railway.app

# Paystack Configuration
# Local dev should use: pk_test_... (test key)
# Production (set in Vercel): pk_live_... (live key)
VITE_PAYSTACK_KEY=pk_test_your_test_key_here

# Site URL (used for canonical URLs, sitemap, and OG tags)
# Local dev: http://localhost:5173
# Production (set in Vercel): https://limes.network
VITE_SITE_URL=https://limes.network
