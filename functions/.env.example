# Environment variables for Firebase Functions
# Copy to .env locally. For production secrets: firebase functions:secrets:set <NAME>
#
# CONTACT_SUPPORT_EMAILS — only who receives the /contact form (submitContactInquiry).
# Does NOT affect signup verification or password reset (those go to the user’s own email).

RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM_ADDRESS=onboarding@resend.dev
FRONTEND_URL=https://yourdomain.com

# Comma-separated (contact form inbox only).
CONTACT_SUPPORT_EMAILS=support@simpal.co.za,christiaan@simpal.co.za,wayne@simpal.co.za,imtiyaaz@simpal.co.za,ryan@simpal.co.za,hayley@simpal.co.za
