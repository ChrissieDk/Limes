{
  "name": "package.json",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.22.2"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "security:exceptions": "node scripts/check-security-exceptions.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "verify": "npm run security:exceptions && npm run lint && npm run test:coverage && npm run build && npm run check:bundle && npm --prefix functions run test:coverage && npm --prefix functions run build",
    "verify:coverage": "npm run verify",
    "doctor": "react-doctor"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@sentry/react": "^10.69.0",
    "@tailwindcss/vite": "^4.1.13",
    "axios": "^1.12.1",
    "classnames": "^2.5.1",
    "firebase": "^12.2.1",
    "lucide-react": "^0.544.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.62.0",
    "react-paystack": "^6.0.0",
    "react-router": "^8.3.0",
    "tailwindcss": "^4.1.13",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "react-doctor": "^0.9.14",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
