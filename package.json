{
  "name": "package.json",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.22.2"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "security:exceptions": "node scripts/check-security-exceptions.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "verify": "npm run security:exceptions && npm run lint && npm run test:coverage && npm run build && npm run check:bundle && npm --prefix functions run test:coverage && npm --prefix functions run build",
    "verify:coverage": "npm run verify",
    "doctor": "react-doctor"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@sentry/react": "^10.69.0",
    "@tailwindcss/vite": "^4.1.13",
    "axios": "^1.12.1",
    "classnames": "^2.5.1",
    "firebase": "^12.2.1",
    "lucide-react": "^0.544.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.62.0",
    "react-paystack": "^6.0.0",
    "react-router": "^8.3.0",
    "tailwindcss": "^4.1.13",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.55.0",
    "@sentry/vite-plugin": "^5.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "react-doctor": "^0.2.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vitest": "^4.1.10"
  }
}
